+function linesOf(text, size, width) {
+  const per = Math.max(1, (width * 3.2) / size);
+  let lines = 0;
+  for (const para of String(text || "").split("\n")) {
+    lines++;
+    let x = 0;
+    for (const tok of para.match(/[A-Za-z0-9'’\-]+|\s+|./gu) || []) {
+      const w = [...tok].reduce((s, c) => s + charW(c), 0);
+      if (/^\s+$/.test(tok)) { x += w; continue; }
+      if (x + w <= per + 1e-6) { x += w; continue; }
+      if (CJK_PUNCT.test(tok)) { lines++; x = 1 + w; continue; }
