+export function safeLines(text, size, width) {
+  const key = `${size}|${Math.round(width * 4)}|${text}`;
+  if (LINES.has(key)) return LINES.get(key);
+  if (LINES.size > 5000) LINES.clear();
+  const n = linesOf(text, size, Math.round(width * 4) / 4);
+  LINES.set(key, n);
